{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weikanggong1/Weikang-BrainMRI/schemas/ukb-vbm-public-report-input-v1.json",
  "title": "UKB VBM aggregate public report input",
  "description": "Aggregate-only input for build_public_report.py. Case-level records, image paths and manifests are outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "study",
    "methods",
    "templates",
    "environment",
    "timing_definitions",
    "analyses",
    "figures",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "run_date", "cohort_description"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "run_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "cohort_description": {"type": "string", "minLength": 1}
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_cases_n", "holdout_n", "tuning_case"],
      "properties": {
        "all_cases_n": {"const": 10},
        "holdout_n": {"const": 9},
        "tuning_case": {"const": "case01"}
      }
    },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "gpu_alternative", "gdc", "geometry_fallback"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "scope"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "gpu_alternative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "status", "equivalence"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "status": {"const": "experimental"},
            "equivalence": {"const": "not_fnirt_equivalent"}
          }
        },
        "gdc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "reason"],
          "properties": {
            "applied": {"const": false},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "geometry_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "case_label", "reason", "method"],
          "properties": {
            "applied": {"const": true},
            "case_label": {"const": "case02"},
            "reason": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/template"}
    },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "timing_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/timing_definition"}
    },
    "analyses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all10", "holdout9"],
      "properties": {
        "all10": {
          "allOf": [
            {"$ref": "#/$defs/analysis"},
            {"properties": {"n": {"const": 10}}}
          ]
        },
        "holdout9": {
          "allOf": [
            {"$ref": "#/$defs/analysis"},
            {"properties": {"n": {"const": 9}}}
          ]
        }
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/figure"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "url", "sha256", "distributed", "source_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "url": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https?://"},
            {"type": "null"}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "distributed": {"const": false},
        "source_status": {"type": "string", "minLength": 1}
      }
    },
    "timing_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "includes", "excludes"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "includes": {"type": "string", "minLength": 1},
        "excludes": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "n", "finding", "metrics", "timings"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "n": {"type": "integer", "minimum": 1},
        "finding": {"type": "string", "minLength": 1},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metric"}
        },
        "timings": {
          "type": "array",
          "items": {"$ref": "#/$defs/timing"}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "metric",
        "statistic",
        "n",
        "left_label",
        "left_value",
        "right_label",
        "right_value",
        "difference_label",
        "difference_value"
      ],
      "properties": {
        "comparison": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "statistic": {"type": "string", "minLength": 1},
        "n": {"type": "integer", "minimum": 1},
        "left_label": {"type": "string", "minLength": 1},
        "left_value": {"type": "number"},
        "right_label": {"type": "string", "minLength": 1},
        "right_value": {"type": "number"},
        "difference_label": {"type": "string", "minLength": 1},
        "difference_value": {"type": "number"},
        "exact_permutation_p": {"type": "number", "minimum": 0, "maximum": 1},
        "direction_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left_better", "right_better", "ties"],
          "properties": {
            "left_better": {"type": "integer", "minimum": 0},
            "right_better": {"type": "integer", "minimum": 0},
            "ties": {"type": "integer", "minimum": 0}
          }
        },
        "note": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "scope", "device", "statistic", "seconds", "n"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "statistic": {"type": "string", "minLength": 1},
        "seconds": {"type": "number", "minimum": 0},
        "n": {"type": "integer", "minimum": 1}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "caption", "n"],
      "properties": {
        "file": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+\\.png$"},
        "caption": {"type": "string", "minLength": 1},
        "n": {"const": 10}
      }
    }
  }
}
